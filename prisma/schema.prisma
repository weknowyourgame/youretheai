generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TurnRole {
  user
  assistant
}

enum RunStatus {
  playing
  passed
  failed
  won
}

model Visitor {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  userAgent   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  runs        Run[]
}

model Run {
  id           String    @id
  visitor      Visitor   @relation(fields: [visitorId], references: [id])
  visitorId    String
  status       RunStatus @default(playing)
  currentLevel Int       @default(1)
  score        Int       @default(0)
  startedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  turns        Turn[]

  @@index([visitorId])
}

model Turn {
  id                String   @id @default(cuid())
  run               Run      @relation(fields: [runId], references: [id])
  runId             String
  levelNumber       Int
  attemptNumber     Int      @default(1)
  turnIndex         Int
  role              TurnRole
  content           String   @db.Text
  createdAt         DateTime @default(now())

  // adversary turns (role = user)
  attackType        String?
  targetedRuleIds   String[]

  // player turns (role = assistant) - judge result
  passed            Boolean?
  helpfulness       Int?
  refusalHardness   Int?
  leakRisk          Int?
  verdict           String?
  ruleResults       Json?
  nextLevelUnlocked Boolean?
  fallbackReason    String?

  @@index([runId, levelNumber, attemptNumber])
}
