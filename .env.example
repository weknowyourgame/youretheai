OPENROUTER_API_KEY=sk-or-...

# Required: Cloudflare AI Gateway. OpenRouter is the provider, but all calls
# must go through this gateway.
AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_name}

# Optional: only needed if the Cloudflare Gateway has "Require authentication" enabled.
CLOUDFLARE_API_TOKEN=

OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=youretheai

# Optional: cap slow free-model calls and fall back to local guardrails/traps.
LLM_TIMEOUT_MS=6000

# Local Postgres (see docker-compose.yml)
DATABASE_URL=postgresql://youretheai:youretheai@localhost:5433/youretheai
